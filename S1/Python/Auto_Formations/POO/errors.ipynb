    "try:\n",
    "    x = int(input(\"Enter an integer: \"))\n",
    "    y = int(input(\"Enter another integer diferent to 0: \"))\n",
    "    z = x/y\n",
    "    print(f\"{x}/{y} = {z}\")\n",
    "except ZeroDivisionError as zerr:\n",
    "    print(zerr)\n",
    "except ValueError as verr:\n",
    "    print(verr)\n"
   ]
